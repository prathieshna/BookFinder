<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#FF6F00</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.WhiteAccent">
        <item name="colorAccent">@color/white</item> <!-- Whatever color you want-->
    </style>

    <!-- Splash Screen Theme - Suppress Android 12+ splash to use custom splash -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background to transparent -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <!-- Disable the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Make splash screen exit immediately -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
